# Salin menjadi .env lalu sesuaikan. Jangan pernah commit .env.

NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/radgate?schema=public"
REDIS_URL="redis://localhost:6379"

# Dua rahasia berbeda. Kalau sama, refresh token yang tercuri bisa langsung dipakai
# sebagai access token.
JWT_ACCESS_SECRET="ganti-dengan-nilai-acak-minimal-32-karakter"
JWT_REFRESH_SECRET="ganti-dengan-nilai-acak-lain-minimal-32-karakter"

# Wildcard tidak boleh dipakai karena cookie dikirim dengan credentials.
CORS_ORIGINS="http://localhost:5173"

# Kunci enkripsi kredensial perangkat (Mikrotik, NAS, PPPoE). Dienkripsi, bukan di-hash,
# karena nilainya perlu dibaca kembali untuk menghubungi perangkat.
DEVICE_ENCRYPTION_KEY="ganti-dengan-32-byte-base64"

RECAPTCHA_SECRET=""
