+import { describe, expect, it } from 'vitest';
+import { buildQuotas } from '../src/modules/bootstrap/bootstrap.controller';
+
+describe('buildQuotas', () => {
+  it('menandai metrik tanpa batas sebagai null, bukan nol', () => {
+    /*
+     * Regresi: dulu metrik yang tidak disebut paket menghasilkan `limit: 0`. Karena
+     * penegakan kuota membandingkan `used < limit`, tenant yang belum punya baris
+     * langganan terkunci dari setiap operasi pembuatan.
+     */
+    const quotas = buildQuotas([], null);
+    expect(quotas.every((q) => q.limit === null)).toBe(true);
+    expect(quotas.every((q) => q.used === 0)).toBe(true);
+  });
+
+  it('memakai batas dari paket dan pemakaian dari tabel usage', () => {
+    const quotas = buildQuotas([{ metric: 'customers', used: 120 }], { customers: 1000, nas: 24 });
+
+    expect(quotas).toContainEqual({ metric: 'customers', used: 120, limit: 1000 });
+    expect(quotas).toContainEqual({ metric: 'nas', used: 0, limit: 24 });
+    expect(quotas).toContainEqual({ metric: 'mikrotik', used: 0, limit: null });
+  });
+
+  it('mempertahankan batas nol sebagai benar-benar nol', () => {
+    // Nol tetap berarti "tidak diizinkan"; yang berubah hanya arti metrik yang absen.
+    const quotas = buildQuotas([], { hotspot_vouchers: 0 });
+    expect(quotas).toContainEqual({ metric: 'hotspot_vouchers', used: 0, limit: 0 });
+  });
+
+  it('mengembalikan seluruh metrik yang dikenal, bukan hanya yang ada di paket', () => {
+    expect(buildQuotas([], { customers: 10 })).toHaveLength(5);
