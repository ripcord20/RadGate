@@ -0,0 +1,30 @@
+import { Injectable, Logger } from '@nestjs/common';
+import type { JobHandler, JobType } from './job-types';
+
+/**
+ * Tempat modul fitur mendaftarkan pemroses job-nya saat modul diinisialisasi. Worker
+ * mencari handler di sini, jadi menambah jenis job baru tidak berarti menyunting worker.
+ */
+@Injectable()
+export class JobRegistry {
+  private readonly logger = new Logger(JobRegistry.name);
+  private readonly handlers = new Map<JobType, JobHandler>();
+
+  register(handler: JobHandler): void {
+    if (this.handlers.has(handler.type)) {
+      // Dua handler untuk satu jenis job berarti salah satunya tidak akan pernah jalan,
+      // dan itu jauh lebih mudah ditemukan sekarang daripada lewat job yang hilang.
+      throw new Error(`Handler untuk job ${handler.type} sudah terdaftar`);
+    }
+    this.handlers.set(handler.type, handler);
+    this.logger.log(`Handler job ${handler.type} terdaftar`);
+  }
+
+  get(type: JobType): JobHandler | undefined {
+    return this.handlers.get(type);
+  }
+
+  get registered(): JobType[] {
+    return [...this.handlers.keys()];
+  }
+}
