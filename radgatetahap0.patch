@@ -0,0 +1,16 @@
+import type { NextFunction, Request, Response } from 'express';
+import { runWithScopeContainer } from './request-context';
+
+/**
+ * Membuka wadah scope untuk setiap permintaan, sebelum guard mana pun berjalan.
+ *
+ * Harus berupa middleware, bukan bagian dari guard. `AsyncLocalStorage.run()` hanya
+ * mempertahankan store selama callback-nya berjalan, jadi guard yang memanggil `run()`
+ * lalu mengembalikan `true` sudah keluar dari konteks sebelum handler dipanggil, dan
+ * `requireScope()` di lapisan repository akan melempar galat. Middleware memanggil
+ * `next()` dari dalam callback, sehingga seluruh sisa rantai — guard, pipe, handler,
+ * interceptor — berjalan di dalam konteks yang sama.
+ */
+export function requestScopeMiddleware(_req: Request, _res: Response, next: NextFunction): void {
+  runWithScopeContainer(() => next());
+}
