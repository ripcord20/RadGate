diff --git a/apps/api/test/request-context.spec.ts b/apps/api/test/request-context.spec.ts
new file mode 100644
index 0000000..3b2d4d1
--- /dev/null
+++ b/apps/api/test/request-context.spec.ts
@@ -0,0 +1,96 @@
+import { describe, expect, it } from 'vitest';
+import {
+  getScope,
+  requireScope,
+  runWithScope,
+  runWithScopeContainer,
+  setScope,
+  tenantWhere,
+  type RequestScope,
+} from '../src/common/request-context';
+
+const teknisiLateng: RequestScope = {
+  userId: 'u-1',
+  tenantId: 't-1',
+  role: 'teknisi',
+  wilayahId: 'w-lateng',
+};
+
+const adminLintasWilayah: RequestScope = {
+  userId: 'u-2',
+  tenantId: 't-1',
+  role: 'admin',
+  wilayahId: null,
+};
+
+describe('scope permintaan', () => {
+  it('tetap terbaca setelah fungsi yang memasangnya selesai', async () => {
+    /*
+     * Regresi untuk bug utama: AuthGuard dulu memasang scope lewat
+     * `runWithScope(scope, () => true)`. AsyncLocalStorage hanya mempertahankan store
+     * selama callback berjalan, jadi scope-nya sudah hilang ketika handler dipanggil dan
+     * seluruh lapisan scoping tenant tidak pernah benar-benar aktif.
+     */
+    const scopeTerbaca = await runWithScopeContainer(async () => {
+      const guard = () => {
+        setScope(teknisiLateng);
+        return true;
+      };
+      expect(guard()).toBe(true);
+
+      // Handler dipanggil setelah guard selesai, persis seperti di siklus Nest.
+      await Promise.resolve();
+      return getScope();
+    });
+
+    expect(scopeTerbaca).toEqual(teknisiLateng);
+  });
+
+  it('terisolasi antar permintaan yang berjalan bersamaan', async () => {
+    const jalankan = (scope: RequestScope, jeda: number) =>
+      runWithScopeContainer(async () => {
+        setScope(scope);
+        await new Promise((resolve) => setTimeout(resolve, jeda));
+        return requireScope().userId;
+      });
+
+    const [pertama, kedua] = await Promise.all([
+      jalankan(teknisiLateng, 20),
+      jalankan(adminLintasWilayah, 5),
+    ]);
+
+    expect(pertama).toBe('u-1');
+    expect(kedua).toBe('u-2');
+  });
+
+  it('menolak query yang berjalan tanpa scope', () => {
+    expect(() => requireScope()).toThrow(/Scope permintaan tidak tersedia/);
+    expect(() => runWithScopeContainer(() => requireScope())).toThrow(
+      /Scope permintaan tidak tersedia/,
+    );
+  });
+
+  it('menolak pemasangan scope di luar wadah yang dibuka middleware', () => {
+    expect(() => setScope(teknisiLateng)).toThrow(/Wadah scope belum dibuka/);
+  });
+
+  it('memberi worker jalan memasang scope sendiri di luar permintaan HTTP', () => {
+    expect(runWithScope(teknisiLateng, () => requireScope().tenantId)).toBe('t-1');
+  });
+});
+
+describe('tenantWhere', () => {
+  it('mengunci pengguna berwilayah ke wilayahnya sendiri, meski meminta wilayah lain', () => {
+    runWithScope(teknisiLateng, () => {
+      expect(tenantWhere('w-ketapang')).toEqual({ tenantId: 't-1', wilayahId: 'w-lateng' });
+    });
+  });
+
+  it('menghormati pilihan wilayah pengguna lintas-wilayah', () => {
+    runWithScope(adminLintasWilayah, () => {
+      expect(tenantWhere('w-ketapang')).toEqual({ tenantId: 't-1', wilayahId: 'w-ketapang' });
+      expect(tenantWhere(null)).toEqual({ tenantId: 't-1' });
+      expect(tenantWhere()).toEqual({ tenantId: 't-1' });
+    });
+  });
+});
