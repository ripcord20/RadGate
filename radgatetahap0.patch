--- /dev/null
+++ b/apps/api/prisma/migrations/20260820000100_row_level_security/migration.sql
@@ -0,0 +1,127 @@
+-- Row Level Security berbasis tenant_id.
+--
+-- Ini lapisan pengaman kedua, bukan yang utama. Filter `tenantId` di lapisan repository
+-- tetap wajib ada. Yang dijaga di sini adalah kasus ketika satu query lupa memfilter:
+-- database yang mengembalikan nol baris, bukan data tenant lain yang bocor.
+--
+-- Konteks tenant dibaca dari parameter sesi `app.tenant_id` yang dipasang
+-- `PrismaService.withTenant()` dengan `is_local = true`, sehingga nilainya hanya berlaku
+-- selama transaksi dan tidak menempel pada koneksi yang dipakai ulang tenant lain.
+
+-- Mengembalikan NULL, bukan melempar galat, ketika parameter belum dipasang. NULL membuat
+-- seluruh perbandingan pada policy bernilai NULL, jadi query tanpa konteks tenant
+-- menghasilkan nol baris. Diam-diam mengembalikan seluruh baris adalah kegagalan yang
+-- justru ingin dicegah lapisan ini.
+CREATE OR REPLACE FUNCTION app_current_tenant_id() RETURNS uuid
+  LANGUAGE sql
+  STABLE
+  AS $$ SELECT nullif(current_setting('app.tenant_id', true), '')::uuid $$;
+
+-- Login dan refresh mencari pengguna lewat email atau id tanpa tahu tenant-nya lebih
+-- dulu; itu satu-satunya query yang memang lintas-tenant. Escape hatch-nya dibuat
+-- eksplisit dan bernama supaya bisa di-grep, bukan berupa "kalau konteks kosong maka
+-- bebas" yang otomatis memaafkan setiap query yang lupa memasang konteks.
+CREATE OR REPLACE FUNCTION app_is_auth_lookup() RETURNS boolean
+  LANGUAGE sql
+  STABLE
+  AS $$ SELECT coalesce(current_setting('app.auth_lookup', true) = 'on', false) $$;
+
+-- FORCE, bukan sekadar ENABLE. Tanpa FORCE, policy dilewati oleh pemilik tabel, dan di
+-- pengembangan aplikasi hampir selalu terhubung sebagai pemilik. Hasilnya RLS yang
+-- terlihat aktif di skema tapi tidak pernah benar-benar menahan apa pun.
+ALTER TABLE "tenants"            ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "tenants"            FORCE  ROW LEVEL SECURITY;
+ALTER TABLE "users"              ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "users"              FORCE  ROW LEVEL SECURITY;
+ALTER TABLE "permissions"        ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "permissions"        FORCE  ROW LEVEL SECURITY;
+ALTER TABLE "wilayah"            ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "wilayah"            FORCE  ROW LEVEL SECURITY;
+ALTER TABLE "settings"           ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "settings"           FORCE  ROW LEVEL SECURITY;
+ALTER TABLE "internet_packages"  ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "internet_packages"  FORCE  ROW LEVEL SECURITY;
+ALTER TABLE "customers"          ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "customers"          FORCE  ROW LEVEL SECURITY;
+ALTER TABLE "invoices"           ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "invoices"           FORCE  ROW LEVEL SECURITY;
+ALTER TABLE "tasks"              ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "tasks"              FORCE  ROW LEVEL SECURITY;
+ALTER TABLE "subscriptions"      ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "subscriptions"      FORCE  ROW LEVEL SECURITY;
+ALTER TABLE "subscription_usage" ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "subscription_usage" FORCE  ROW LEVEL SECURITY;
+
+-- `tenants` dikunci lewat primary key-nya, bukan lewat kolom tenantId yang tidak ada.
+CREATE POLICY tenants_isolation ON "tenants"
+  USING ("id" = app_current_tenant_id())
+  WITH CHECK ("id" = app_current_tenant_id());
+
+CREATE POLICY users_isolation ON "users"
+  USING ("tenantId" = app_current_tenant_id())
+  WITH CHECK ("tenantId" = app_current_tenant_id());
+
+-- Policy permissive kedua di-OR dengan yang pertama, jadi selama tahap autentikasi
+-- pencarian pengguna lintas-tenant diizinkan untuk SELECT saja. Menulis tetap terkunci
+-- ke tenant aktif.
+CREATE POLICY users_auth_lookup ON "users"
+  FOR SELECT
+  USING (app_is_auth_lookup());
+
+CREATE POLICY permissions_isolation ON "permissions"
+  USING ("tenantId" = app_current_tenant_id())
+  WITH CHECK ("tenantId" = app_current_tenant_id());
+
+CREATE POLICY wilayah_isolation ON "wilayah"
+  USING ("tenantId" = app_current_tenant_id())
+  WITH CHECK ("tenantId" = app_current_tenant_id());
+
+CREATE POLICY settings_isolation ON "settings"
+  USING ("tenantId" = app_current_tenant_id())
+  WITH CHECK ("tenantId" = app_current_tenant_id());
+
+CREATE POLICY internet_packages_isolation ON "internet_packages"
+  USING ("tenantId" = app_current_tenant_id())
+  WITH CHECK ("tenantId" = app_current_tenant_id());
+
+CREATE POLICY customers_isolation ON "customers"
+  USING ("tenantId" = app_current_tenant_id())
+  WITH CHECK ("tenantId" = app_current_tenant_id());
+
+CREATE POLICY invoices_isolation ON "invoices"
+  USING ("tenantId" = app_current_tenant_id())
+  WITH CHECK ("tenantId" = app_current_tenant_id());
+
+CREATE POLICY tasks_isolation ON "tasks"
+  USING ("tenantId" = app_current_tenant_id())
+  WITH CHECK ("tenantId" = app_current_tenant_id());
+
+CREATE POLICY subscriptions_isolation ON "subscriptions"
+  USING ("tenantId" = app_current_tenant_id())
+  WITH CHECK ("tenantId" = app_current_tenant_id());
+
+CREATE POLICY subscription_usage_isolation ON "subscription_usage"
+  USING ("tenantId" = app_current_tenant_id())
+  WITH CHECK ("tenantId" = app_current_tenant_id());
+
+-- `subscription_plans` sengaja dibiarkan tanpa RLS: katalog paket langganan platform
+-- sama untuk semua tenant dan tidak memuat data operator mana pun.
+
+-- Superuser dan pemilik dengan BYPASSRLS melewati policy apa pun, termasuk yang FORCE.
+-- Karena itu aplikasi wajib terhubung sebagai peran biasa. Blok di bawah memberi hak
+-- pada peran `radgate_app` bila peran itu memang sudah dibuat; kalau belum, migrasi tetap
+-- lolos supaya pemasangan baru tidak terhenti di sini. Cara membuat perannya ada di
+-- apps/api/README.md.
+DO $$
+BEGIN
+  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'radgate_app') THEN
+    GRANT USAGE ON SCHEMA public TO radgate_app;
+    GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO radgate_app;
+    GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO radgate_app;
+    ALTER DEFAULT PRIVILEGES IN SCHEMA public
+      GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO radgate_app;
+    ALTER DEFAULT PRIVILEGES IN SCHEMA public
+      GRANT USAGE, SELECT ON SEQUENCES TO radgate_app;
+  END IF;
+END
+$$;
diff --git a/apps/api/prisma/rls-check.sh b/apps/api/prisma/rls-check.sh
new file mode 100755
