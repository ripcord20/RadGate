+import { Global, Module } from '@nestjs/common';
+import { JobRegistry } from './job-registry';
+import { QueueService } from './queue.service';
+import { QueueWorker } from './queue.worker';
+
+/**
+ * Global karena hampir setiap modul fitur perlu mendaftarkan job: sinkronisasi Mikrotik,
+ * broadcast WhatsApp, generate tagihan, dan import Excel.
+ */
+@Global()
+@Module({
+  providers: [QueueService, JobRegistry, QueueWorker],
+  exports: [QueueService, JobRegistry],
+})
+export class QueueModule {}
diff --git a/apps/api/src/queue/queue.service.ts b/apps/api/src/queue/queue.service.ts
new file mode 100644
index 0000000..75a31cb
--- /dev/null
+++ b/apps/api/src/queue/queue.service.ts
@@ -0,0 +1,53 @@
+import { Injectable, Logger, type OnModuleDestroy } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { Queue } from 'bullmq';
+import IORedis, { type Redis } from 'ioredis';
+import { RADGATE_QUEUE, type JobData, type JobType } from './job-types';
+
+/**
+ * Pembungkus BullMQ. Modul fitur tidak menyentuh BullMQ langsung, supaya mengganti
+ * implementasi antrean tidak berarti menyunting setiap modul yang mendaftarkan job.
+ */
+@Injectable()
+export class QueueService implements OnModuleDestroy {
+  private readonly logger = new Logger(QueueService.name);
+  private readonly connection: Redis;
+  private readonly queue: Queue<JobData>;
+
+  constructor(private readonly config: ConfigService) {
+    this.connection = createRedisConnection(this.config);
+    this.queue = new Queue<JobData>(RADGATE_QUEUE, { connection: this.connection });
+  }
+
+  /**
+   * Percobaan ulang dengan jeda menaik. Sinkronisasi Mikrotik dan pengiriman WhatsApp
+   * gagal karena perangkat atau gateway sedang tidak bisa dihubungi, dan itu jenis
+   * kegagalan yang biasanya pulih sendiri beberapa detik kemudian.
+   */
+  async add(type: JobType, data: JobData): Promise<void> {
+    await this.queue.add(type, data, {
+      jobId: data.taskId,
+      attempts: 3,
+      backoff: { type: 'exponential', delay: 5_000 },
+      removeOnComplete: 100,
+      removeOnFail: 500,
+    });
+    this.logger.debug(`Job ${type} (${data.taskId}) masuk antrean`);
+  }
+
+  async onModuleDestroy() {
+    await this.queue.close();
+    await this.connection.quit();
+  }
+}
+
+/**
+ * `maxRetriesPerRequest: null` adalah syarat BullMQ, bukan pilihan gaya: koneksi yang
+ * dipakai worker menunggu perintah blocking, dan batas percobaan bawaan ioredis akan
+ * memutusnya sebagai gagal.
+ */
+export function createRedisConnection(config: ConfigService): Redis {
+  return new IORedis(config.get<string>('REDIS_URL') ?? 'redis://localhost:6379', {
+    maxRetriesPerRequest: null,
+  });
+}
diff --git a/apps/api/src/queue/queue.worker.ts b/apps/api/src/queue/queue.worker.ts
new file mode 100644
index 0000000..f389cd8
--- /dev/null
+++ b/apps/api/src/queue/queue.worker.ts
@@ -0,0 +1,90 @@
+import { Injectable, Logger, type OnApplicationBootstrap, type OnModuleDestroy } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { Worker, type Job } from 'bullmq';
+import type { Redis } from 'ioredis';
+import { runWithScope } from '../common/request-context';
+import { JobRegistry } from './job-registry';
+import { RADGATE_QUEUE, type JobData, type JobType } from './job-types';
+import { createRedisConnection } from './queue.service';
+import { TasksService } from '../modules/tasks/tasks.service';
+
+/**
+ * Worker antrean. Berjalan di proses yang sama dengan API selama beban masih ringan;
+ * memisahkannya nanti cukup dengan menjalankan proses kedua yang hanya memuat modul ini.
+ *
+ * Dimulai pada `onApplicationBootstrap`, bukan `onModuleInit`, supaya seluruh modul fitur
+ * sempat mendaftarkan handler-nya sebelum job pertama diambil.
+ */
+@Injectable()
+export class QueueWorker implements OnApplicationBootstrap, OnModuleDestroy {
+  private readonly logger = new Logger(QueueWorker.name);
+  private connection?: Redis;
+  private worker?: Worker<JobData>;
+
+  constructor(
+    private readonly config: ConfigService,
+    private readonly registry: JobRegistry,
+    private readonly tasks: TasksService,
+  ) {}
+
+  onApplicationBootstrap() {
+    if (this.config.get('QUEUE_WORKER_DISABLED') === 'true') {
+      this.logger.warn('Worker antrean dimatikan lewat QUEUE_WORKER_DISABLED');
+      return;
+    }
+
+    this.connection = createRedisConnection(this.config);
+    this.worker = new Worker<JobData>(RADGATE_QUEUE, (job) => this.process(job), {
+      connection: this.connection,
+      concurrency: Number(this.config.get('QUEUE_CONCURRENCY') ?? 5),
+    });
+
+    this.worker.on('failed', (job, error) => {
+      this.logger.error(`Job ${job?.name} (${job?.id}) gagal: ${error.message}`);
+    });
+
+    this.logger.log(`Worker antrean berjalan. Handler terdaftar: ${this.registry.registered.join(', ') || '-'}`);
+  }
+
+  private async process(job: Job<JobData>): Promise<unknown> {
+    const handler = this.registry.get(job.name as JobType);
+    const { taskId, tenantId } = job.data;
+
+    if (!handler) {
+      // Ditandai gagal, bukan didiamkan. Job tanpa handler adalah salah pasang modul, dan
+      // baris `tasks` yang menggantung di status `pending` selamanya tidak memberi tahu
+      // siapa pun bahwa ada yang salah.
+      await this.tasks.fail(taskId, tenantId, `Tidak ada handler untuk job ${job.name}`);
+      throw new Error(`Tidak ada handler untuk job ${job.name}`);
+    }
+
+    /*
+     * Worker berjalan di luar permintaan HTTP, jadi tidak ada guard yang memasang scope.
+     * Scope dipasang di sini dari tenant milik job, supaya `withTenant()` dan seluruh
+     * lapisan repository berperilaku persis sama seperti saat melayani permintaan.
+     */
+    return runWithScope(
+      { userId: 'system', tenantId, role: 'owner', wilayahId: null },
+      async () => {
+        await this.tasks.start(taskId, tenantId);
+        try {
+          const result = await handler.handle({
+            data: job.data,
+            report: (progress, total) => this.tasks.updateProgress(taskId, tenantId, progress, total),
+          });
+          await this.tasks.finish(taskId, tenantId, result ?? undefined);
+          return result;
+        } catch (error) {
+          const message = error instanceof Error ? error.message : String(error);
+          await this.tasks.fail(taskId, tenantId, message);
+          throw error;
+        }
+      },
+    );
+  }
+
+  async onModuleDestroy() {
+    await this.worker?.close();
+    await this.connection?.quit();
+  }
+}
