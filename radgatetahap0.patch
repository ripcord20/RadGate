+/**
+ * Jenis job yang dikenal antrean. Sama persis dengan `TaskType` pada modul tasks, karena
+ * setiap job selalu punya satu baris `tasks` sebagai jejaknya yang bisa dilihat pengguna.
+ */
+export type JobType =
+  | 'mikrotik.sync'
+  | 'whatsapp.broadcast'
+  | 'invoice.generate'
+  | 'customer.import'
+  | 'device.poll'
+  | 'report.snapshot';
+
+/**
+ * Muatan yang dibawa setiap job. `taskId` dan `tenantId` selalu ada supaya worker bisa
+ * memperbarui progres dan memasang konteks tenant tanpa menebak.
+ */
+export interface JobData {
+  taskId: string;
+  tenantId: string;
+  payload: Record<string, unknown>;
+}
+
+/** Progres dilaporkan lewat callback, bukan dengan menulis ke tabel langsung dari handler. */
+export interface JobContext {
+  data: JobData;
+  report: (progress: number, total?: number) => Promise<void>;
+}
+
+export interface JobHandler {
+  type: JobType;
+  handle: (ctx: JobContext) => Promise<Record<string, unknown> | void>;
+}
+
+/** Satu antrean untuk semua jenis job; jenisnya dibedakan lewat nama job BullMQ. */
+export const RADGATE_QUEUE = 'radgate';
