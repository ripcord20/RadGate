--- /dev/null
+++ b/apps/api/prisma/rls-check.sh
@@ -0,0 +1,98 @@
+#!/usr/bin/env bash
+#
+# Memeriksa bahwa Row Level Security benar-benar menahan, bukan sekadar terpasang di
+# skema. Dijalankan CI setelah migrasi.
+#
+# Wajib memakai peran biasa. Superuser dan peran dengan BYPASSRLS melewati policy apa pun,
+# termasuk yang FORCE, sehingga pengujian yang dijalankan sebagai `postgres` akan lulus
+# tanpa membuktikan apa pun.
+#
+#   DATABASE_URL      peran pemilik, untuk menyiapkan data uji
+#   APP_DATABASE_URL  peran aplikasi, yang tunduk pada policy
+set -euo pipefail
+
+: "${DATABASE_URL:?DATABASE_URL belum diatur}"
+: "${APP_DATABASE_URL:?APP_DATABASE_URL belum diatur}"
+
+T_A='11111111-1111-1111-1111-111111111111'
+T_B='22222222-2222-2222-2222-222222222222'
+
+# `?schema=public` adalah parameter Prisma, bukan parameter koneksi PostgreSQL; psql
+# menolaknya. Dibuang di sini supaya satu variabel lingkungan bisa dipakai keduanya.
+PG_OWNER="${DATABASE_URL%%\?*}"
+PG_APP="${APP_DATABASE_URL%%\?*}"
+
+owner() { psql "$PG_OWNER" -v ON_ERROR_STOP=1 -qtA "$@"; }
+app()   { psql "$PG_APP" -v ON_ERROR_STOP=1 -qtA "$@"; }
+
+gagal() { echo "GAGAL: $1" >&2; exit 1; }
+
+# Penanda unik per jalankan, supaya pemeriksaan ini tidak bergantung pada database yang
+# benar-benar kosong dan tidak bentrok dengan data uji yang sudah ada.
+TAG="rlscheck-$$"
+
+echo '== menyiapkan dua tenant =='
+owner <<SQL >/dev/null
+BEGIN;
+SELECT set_config('app.tenant_id', '$T_A', true);
+INSERT INTO tenants (id, name, "createdAt", "updatedAt")
